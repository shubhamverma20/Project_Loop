# Production Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require"

# Auth Secrets & Credentials
JWT_SECRET="your_long_random_jwt_secret_key_min_32_chars"
AUTH_SECRET="your_long_random_jwt_secret_key_min_32_chars"
NEXTAUTH_URL="https://your-frontend.vercel.app"

# Google OAuth Server Configuration (Keep GOOGLE_CLIENT_SECRET private)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
AUTH_GOOGLE_ID="your_google_client_id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your_google_client_secret"

# External AI & Email Service Keys
NVIDIA_API_KEY="your_nvidia_api_key"
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"
OPENROUTER_API_KEY="your_openrouter_api_key"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"
BREVO_API_KEY="your_brevo_api_key"
BREVO_SENDER_EMAIL="noreply@yourdomain.com"
BREVO_SENDER_NAME="Project LOOP Security"

# Upstash Redis Serverless Rate Limiting (Optional)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# CORS & Server Config
FRONTEND_URL="https://your-frontend.vercel.app,http://localhost:3000"
PORT=5000
